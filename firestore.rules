rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStudentEmail() {
      return request.auth.token.email is string
             && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function isStaffEmail() {
      return request.auth.token.email is string
             && request.auth.token.email.matches('^[^@]+@alueducation[.]com$');
    }

    function roleMatchesEmail(role) {
      return (isStudentEmail() && role == 'student')
             || (isStaffEmail() && role == 'staff');
    }
    
    function isStaff() {
      return isAuthenticated() && 
             isStaffEmail() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && 
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       roleMatchesEmail(request.resource.data.role);
      allow update: if isOwner(userId) && 
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email &&
                       (request.resource.data.role == resource.data.role ||
                        roleMatchesEmail(request.resource.data.role));
      allow delete: if false; // Users cannot be deleted
    }
    
    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      
      allow create: if isStaff() ||
               (isAuthenticated() &&
            request.resource.data.reporterId == request.auth.uid &&
            request.resource.data.status == 'submitted' &&
            request.resource.data.category in ['facilities', 'water', 'electricity', 'safety', 'sanitation', 'furniture'] &&
            request.resource.data.priority in ['low', 'medium', 'high'] &&
            request.resource.data.title is string &&
            request.resource.data.description is string &&
            request.resource.data.location is string &&
            request.resource.data.statusHistory.size() == 1);
      
      allow update: if (isOwner(resource.data.reporterId) && 
                        resource.data.status == 'submitted' &&
                        request.resource.data.status == 'submitted' &&
                        request.resource.data.reporterId == resource.data.reporterId) ||
                       isStaff();
      
      allow delete: if isStaff() ||
               (isOwner(resource.data.reporterId) &&
            resource.data.status == 'submitted');
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isStaff() &&
                       request.resource.data.userId is string &&
                       request.resource.data.incidentId is string &&
                       request.resource.data.title is string &&
                       request.resource.data.message is string &&
                       request.resource.data.read is bool;
      allow update: if isStaff() ||
                       (isAuthenticated() &&
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                        request.resource.data.read is bool);
      allow delete: if isStaff();
    }
  }
}
