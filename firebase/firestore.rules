rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStudentEmail() {
      return request.auth.token.email is string
             && request.auth.token.email.matches('^[^@]+@alustudent[.]com$');
    }

    function isStaffEmail() {
      return request.auth.token.email is string
             && request.auth.token.email.matches('^[^@]+@alueducation[.]com$');
    }

    function roleMatchesEmail(role) {
      return (isStudentEmail() && role == 'student')
             || (isStaffEmail() && role == 'staff');
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isStaff() {
      return isAuthenticated()
             && isStaffEmail()
             && getUserData().role == 'staff';
    }
    
    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read any user's basic info (for displaying reporter names, etc.)
      allow read: if isAuthenticated();
      
      // Only the user can create their own document during registration
      allow create: if isOwner(userId) 
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && roleMatchesEmail(request.resource.data.role)
                    && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'department', 'createdAt']);
      
      // Only the user can update their own profile, but cannot change role or uid
      allow update: if isOwner(userId)
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.email == resource.data.email
              && (request.resource.data.role == resource.data.role
                || roleMatchesEmail(request.resource.data.role));
      
      // Users cannot delete their own account (admin operation)
      allow delete: if false;
    }
    
    // Incidents collection
    match /incidents/{incidentId} {
      // All authenticated users can read all incidents
      // Alternative: allow read: if isOwner(resource.data.reporterId) || isStaff();
      allow read: if isAuthenticated();
      
      // Students can create incidents only with their own uid as reporterId and initial status "submitted"
      allow create: if isStaff() ||
            (isAuthenticated()
             && request.resource.data.reporterId == request.auth.uid
             && request.resource.data.status == 'submitted'
             && request.resource.data.keys().hasAll(['title', 'description', 'category', 'priority', 'location', 'status', 'reporterId', 'reporterName', 'createdAt', 'updatedAt', 'statusHistory']));
      
      // Students can update their own incidents only while status is "submitted"
      // They cannot change status, reporterId, or reporterName
      allow update: if isAuthenticated()
                    && isOwner(resource.data.reporterId)
                    && resource.data.status == 'submitted'
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reporterId', 'reporterName', 'createdAt', 'statusHistory', 'staffNote']);
      
      // Staff can update any incident to change status and add notes
      allow update: if isStaff();
      
      // Students can delete their own incidents only while status is "submitted"
      allow delete: if isStaff() ||
                    (isAuthenticated()
                     && isOwner(resource.data.reporterId)
                     && resource.data.status == 'submitted');
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isStaff());

      allow create: if isStaff()
                    && request.resource.data.userId is string
                    && request.resource.data.incidentId is string
                    && request.resource.data.title is string
                    && request.resource.data.message is string
                    && request.resource.data.read is bool;

      allow update: if isStaff()
                    || (isAuthenticated()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                        && request.resource.data.read is bool);

      allow delete: if isStaff();
    }
  }
}
